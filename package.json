{
  "name": "duxsoup-etl",
  "version": "1.0.0",
  "description": "LinkedIn ETL system for DuxSoup webhook data",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --config=jest.config.unit.js",
    "test:integration": "jest --config=jest.config.integration.js",
    "test:all": "npm test && npm run test:integration",
    "test:watch": "jest --watch --config=jest.config.unit.js",
    "test:coverage": "jest --coverage --config=jest.config.unit.js",
    "test:verbose": "jest --verbose --config=jest.config.unit.js",
    "backfill:canonical-id": "node scripts/backfillCanonicalId.js --dry-run",
    "backfill:company-id": "node scripts/backfillCompanyCanonicalId.js --dry-run",
    "backfill:location-id": "node scripts/backfillLocationCanonicalId.js --dry-run",
    "rebuild:companies": "node scripts/rebuildCompanies.js --dry-run",
    "rebuild:locations": "node scripts/rebuildLocations.js --dry-run",
    "migrate:locations": "node scripts/migrateLocationStructure.js --dry-run",
    "migrate:locations:run": "node scripts/migrateLocationStructure.js",
    "migrate:locations:prod": "NODE_ENV=production node scripts/migrateLocationStructure.js",
    "audit:canonical-id": "node -e \"const mongoose=require('mongoose');const Person=require('./src/models/person');(async()=>{const uri=process.env.MONGODB_URI||'mongodb://localhost:27017/duxsoup-etl';await mongoose.connect(uri);const missing=await Person.countDocuments({\\$or:[{canonical_id:{\\$exists:false}},{canonical_id:null},{canonical_id:''}]});const total=await Person.countDocuments({});const sample=await Person.find({canonical_id:{\\$exists:true}}).limit(3).select('_id canonical_id aliases').lean();console.log({total,missing,sample});await mongoose.disconnect();})();\"",
    "dedupe:aliases": "node scripts/dedupeAliases.js --dry-run",
    "backfill:phone": "node scripts/backfillPhoneNormalization.js --dry-run",
    "backfill:twitter": "node scripts/backfillTwitterNormalization.js --dry-run",
    "backfill:html-sanitize": "node scripts/backfillHtmlSanitization.js --dry-run",
    "backfill:seniority": "node scripts/backfillSeniority.js",
    "cleanup:roles": "node scripts/cleanupRoles.js --dry-run",
    "import:csv": "node scripts/import-csv-visits.js",
    "ops": "node scripts/cli.js",
    "ops:merge": "node scripts/cli.js merge-duplicates",
    "ops:link-orphans": "node scripts/cli.js link-orphans",
    "ops:migrate-ids": "node scripts/cli.js migrate-url-ids",
    "ops:rollback-merge": "node scripts/rollback-merge.js",
    "resurrect:dead-letters": "node scripts/resurrectDeadLetters.js",
    "lint": "eslint src/ __tests__/",
    "prepare": "husky || true"
  },
  "keywords": [
    "linkedin",
    "etl",
    "webhook",
    "duxsoup"
  ],
  "author": "Mike Hare",
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.18.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "libphonenumber-js": "^1.12.37",
    "mongoose": "^9.2.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.1",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.12.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.1",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "__tests__/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "packageManager": "npm@10.8.2"
}
