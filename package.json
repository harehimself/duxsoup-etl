{
  "name": "duxsoup-etl",
  "version": "1.0.0",
  "description": "LinkedIn ETL system for DuxSoup webhook data",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --config=jest.config.unit.js",
    "test:integration": "jest --config=jest.config.integration.js",
    "test:all": "npm test && npm run test:integration",
    "test:watch": "jest --watch --config=jest.config.unit.js",
    "test:coverage": "jest --coverage --config=jest.config.unit.js",
    "test:verbose": "jest --verbose --config=jest.config.unit.js"
  },
  "keywords": [
    "linkedin",
    "etl",
    "webhook",
    "duxsoup"
  ],
  "author": "Mike Hare",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongoose": "^8.15.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^9.28.0",
    "jest": "^30.2.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.5.3",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
