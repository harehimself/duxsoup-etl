# DuxSoup ETL Configuration
NODE_ENV=development
PORT=3000

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/duxsoup-etl?retryWrites=true&w=majority

# CORS Configuration (comma-separated list of allowed origins, or * for all)
ALLOWED_ORIGINS=*

# Logging Level
LOG_LEVEL=info

# Canonical ID namespace (UUID v4/v5 format) - keep stable across environments
CANONICAL_ID_NAMESPACE=9a6c1cf1-5f9f-4f7e-9b5d-3a0d8d8c0f1a
